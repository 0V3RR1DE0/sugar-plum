#!/usr/bin/env bash
# Sugar Plum quick archive actions, launched from Dolphin/KIO.
# Every operation re-opens in a terminal so the 7z/unrar/tar output is live.
set -uo pipefail

if [ "${SUGAR_7Z_TERM:-0}" != "1" ]; then
  export SUGAR_7Z_TERM=1
  for term in ghostty konsole xterm; do
    command -v "$term" >/dev/null 2>&1 || continue
    case "$term" in
      ghostty) exec ghostty -e "$0" "$@" ;;
      konsole) exec konsole -e "$0" "$@" ;;
      xterm)   exec xterm -e "$0" "$@" ;;
    esac
  done
fi

mode="${1:-}"
shift || true
files=("$@")
[ "${#files[@]}" -gt 0 ] || exit 0

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Sugar Plum" "$@" >/dev/null 2>&1 || true; }
have() { command -v "$1" >/dev/null 2>&1; }

fail() {
  echo
  echo "✗ $*"
  notify -u critical -i dialog-error "Archive failed" "$*"
  echo
  read -r -p "Press Enter to close…" _ || true
  exit 1
}

ask_pass() {
  local p1 p2
  p1="$(zenity --password --title="Archive password" 2>/dev/null)" || return 1
  [ -n "$p1" ] || return 1
  p2="$(zenity --password --title="Confirm password" 2>/dev/null)" || return 1
  if [ "$p1" != "$p2" ]; then
    zenity --error --title="Passwords" --text="The passwords do not match." 2>/dev/null || true
    return 1
  fi
  printf '%s' "$p1"
}

strip_archive_ext() {
  local b="$1"
  case "$b" in
    *.tar.gz|*.tar.xz|*.tar.zst|*.tar.bz2) b="${b%.*.*}" ;;
    *.tgz|*.txz|*.tbz2) b="${b%.*}" ;;
    *) b="${b%.*}" ;;
  esac
  printf '%s' "$b"
}

unique_out() {
  local dir="$1" base="$2" ext="$3" out i=2
  out="$dir/$base.$ext"
  while [ -e "$out" ]; do
    out="$dir/$base-$i.$ext"
    i=$((i + 1))
  done
  printf '%s' "$out"
}

compress() {
  local fmt="$1" want_pass="$2"; shift 2
  local -a src=("$@")
  [ "${#src[@]}" -gt 0 ] || fail "Nothing selected."

  local first dir base ext="7z" pass=""
  first="$(readlink -f -- "${src[0]}")"
  dir="$(dirname -- "$first")"
  base="$(basename -- "$first")"
  if [ "${#src[@]}" -eq 1 ] && [ ! -d "$first" ]; then
    base="$(strip_archive_ext "$base")"
  elif [ "${#src[@]}" -gt 1 ]; then
    base="$(basename -- "$dir")"
    [ "$base" = "/" ] && base="Archive"
  fi
  [ -n "$base" ] || base="Archive"

  case "$fmt" in
    7z) ext="7z" ;;
    zip) ext="zip" ;;
    targz) ext="tar.gz" ;;
    tar) ext="tar" ;;
  esac

  if [ "$want_pass" = "1" ]; then
    pass="$(ask_pass)" || exit 0
    [ -n "$pass" ] || exit 0
  fi

  local out; out="$(unique_out "$dir" "$base" "$ext")"
  local -a names=()
  local f
  for f in "${src[@]}"; do names+=("$(basename -- "$f")"); done

  echo "→ ${base}.${ext}"
  notify "Compressing" "${base}.${ext}"

  ( cd "$dir" || exit 1
    case "$fmt" in
      7z)
        local -a args=(-t7z -mx=5 -mmt=on -bsp1 -y)
        [ -n "$pass" ] && args+=(-p"$pass" -mhe=on)
        7z a "${args[@]}" "$out" -- "${names[@]}"
        ;;
      zip)
        local -a args=(-tzip -mx=5 -mmt=on -bsp1 -y)
        [ -n "$pass" ] && args+=(-p"$pass")
        7z a "${args[@]}" "$out" -- "${names[@]}"
        ;;
      targz) tar -czvf "$out" -- "${names[@]}" ;;
      tar)   tar -cvf  "$out" -- "${names[@]}" ;;
    esac
  ) || fail "Compression failed."

  notify -i package-x-generic "Compressed" "$out"
}

extract() {
  local where="$1" want_pass="$2"; shift 2
  local -a src=("$@")
  [ "${#src[@]}" -gt 0 ] || fail "Nothing selected."

  local pass=""
  if [ "$want_pass" = "1" ]; then
    pass="$(ask_pass)" || exit 0
    [ -n "$pass" ] || exit 0
  fi

  local a dir base out
  for a in "${src[@]}"; do
    a="$(readlink -f -- "$a")"
    [ -f "$a" ] || continue
    dir="$(dirname -- "$a")"
    base="$(basename -- "$a")"

    if [ "$where" = "to" ]; then
      local suggested; suggested="$dir/$(strip_archive_ext "$base")"
      out="$(zenity --file-selection --directory --title="Extract $base to…" --filename="$suggested/" 2>/dev/null)" || exit 0
      [ -n "$out" ] || exit 0
    else
      out="$dir"
    fi
    mkdir -p -- "$out" || fail "Could not create $out."

    echo "→ extracting $base to $out"
    notify "Extracting" "$base"

    case "${base,,}" in
      *.rar)
        if have unrar; then
          unrar x -o- -y ${pass:+-p"$pass"} "$a" "$out/" || fail "unrar failed on $base."
        else
          7z x -bsp1 -aos -y ${pass:+-p"$pass"} -o"$out" -- "$a" || fail "7z failed on $base."
        fi
        ;;
      *.tar.gz|*.tgz)   tar -xzvf "$a" -C "$out" || fail "tar failed on $base." ;;
      *.tar.xz|*.txz)   tar -xJvf "$a" -C "$out" || fail "tar failed on $base." ;;
      *.tar.zst)        tar --zstd -xvf "$a" -C "$out" || fail "tar failed on $base." ;;
      *.tar.bz2|*.tbz2) tar -xjvf "$a" -C "$out" || fail "tar failed on $base." ;;
      *.tar)            tar -xvf "$a" -C "$out" || fail "tar failed on $base." ;;
      *)
        7z x -bsp1 -aos -y ${pass:+-p"$pass"} -o"$out" -- "$a" || fail "7z failed on $base."
        ;;
    esac
  done

  notify -i package-x-generic "Extracted" "$where"
}

case "$mode" in
  7z)        compress 7z 0 "$@" ;;
  zip)       compress zip 0 "$@" ;;
  targz)     compress targz 0 "$@" ;;
  tar)       compress tar 0 "$@" ;;
  7zpass)    compress 7z 1 "$@" ;;
  zippass)   compress zip 1 "$@" ;;
  extracthere) extract here 0 "$@" ;;
  extractto)   extract to 0 "$@" ;;
  extractpass) extract here 1 "$@" ;;
  *) exit 1 ;;
esac
