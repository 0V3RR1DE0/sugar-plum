[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
Name=7-Zip
Actions=add;sevenzip;zip;targz;tar;rar;sevenzippass;zippass;
X-KDE-Submenu=7-Zip
X-KDE-Priority=TopLevel
Icon=sugar-archive

[Desktop Action add]
Name=Add to archive…
Icon=sugar-archive
Exec=@GUI@ %F

[Desktop Action sevenzip]
Name=Add to archive (7z)
Icon=application-x-7z-compressed
Exec=@BIN@ 7z %F

[Desktop Action zip]
Name=Add to archive (ZIP)
Icon=sugar-archive
Exec=@BIN@ zip %F

[Desktop Action targz]
Name=Add to archive (tar.gz)
Icon=application-x-compressed-tar
Exec=@BIN@ targz %F

[Desktop Action tar]
Name=Add to archive (tar)
Icon=application-x-tar
Exec=@BIN@ tar %F

[Desktop Action rar]
Name=Add to archive (RAR)…
Icon=application-x-rar
Exec=@GUI@ --rar %F

[Desktop Action sevenzippass]
Name=Add to archive (7z, password)…
Icon=application-x-7z-compressed
Exec=@BIN@ 7zpass %F

[Desktop Action zippass]
Name=Add to archive (ZIP, password)…
Icon=sugar-archive
Exec=@BIN@ zippass %F
