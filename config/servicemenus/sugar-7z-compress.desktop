[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
Name=7-Zip
Actions=sevenzip;zip;targz;tar;sevenzippass;zippass;
X-KDE-Submenu=7-Zip
X-KDE-Priority=TopLevel
Icon=package-x-generic

[Desktop Action sevenzip]
Name=7z
Icon=application-x-7z-compressed
Exec=@BIN@ 7z %F

[Desktop Action zip]
Name=ZIP
Icon=application-zip
Exec=@BIN@ zip %F

[Desktop Action targz]
Name=tar.gz
Icon=application-x-compressed-tar
Exec=@BIN@ targz %F

[Desktop Action tar]
Name=tar
Icon=application-x-tar
Exec=@BIN@ tar %F

[Desktop Action sevenzippass]
Name=7z with password…
Icon=application-x-7z-compressed
Exec=@BIN@ 7zpass %F

[Desktop Action zippass]
Name=ZIP with password…
Icon=application-zip
Exec=@BIN@ zippass %F
